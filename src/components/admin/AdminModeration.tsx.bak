'use client';

import React, { useState, useEffect, useCallback } from 'react';
import { 
  Search, 
  ChevronLeft, 
  ChevronRight, 
  ChevronDown,
  X, 
  AlertCircle,
  ExternalLink,
  MessageSquare,
  FileText,
  UserX,
  CheckCircle,
  Shield,
  Plus,
  RefreshCw,
  RotateCcw
} from 'lucide-react';
import { createPortal } from 'react-dom';

export interface ReportItem {
  id: number;
  report_code: string;
  reporter_id: number | null;
  reporter_name: string;
  reported_user_id: number | null;
  reported_user_name: string;
  report_type: 'chat' | 'content' | 'user';
  target_id: number | null;
  reason: string;
  statement: string;
  date_reported: string;
  url: string;
  severity: 'low' | 'medium' | 'high' | 'critical';
  status: 'pending' | 'high_risk' | 'escalated' | 'resolved' | 'dismissed' | 'suspended';
  created_at?: string;
}

export function AdminModeration() {
  const [reports, setReports] = useState<ReportItem[]>([]);
  const [stats, setStats] = useState({
    totalReports: 15,
    pending: 7,
    highRisk: 10,
    escalated: 2
  });
  const [isLoading, setIsLoading] = useState(true);
  const [searchQuery, setSearchQuery] = useState('');
  const [filter, setFilter] = useState<string>('all');
  
  // Pagination State (Default 6 items per page matching the 6 rows in the reference image)
  const [currentPage, setCurrentPage] = useState(1);
  const [pageSize, setPageSize] = useState(6);
  const [totalCount, setTotalCount] = useState(15);
  const [totalPages, setTotalPages] = useState(3);

  // Modals & Toasts
  const [selectedReport, setSelectedReport] = useState<ReportItem | null>(null);
  const [isSimulateModalOpen, setIsSimulateModalOpen] = useState(false);
  const [toast, setToast] = useState<{ title: string; message: string; type?: 'success' | 'error' } | null>(null);
  const [actionLoadingId, setActionLoadingId] = useState<number | null>(null);

  // New report form state (for filing reports from chat or content into MySQL)
  const [newReporterName, setNewReporterName] = useState('Paulbert');
  const [newReportedUser, setNewReportedUser] = useState('Chris manual');
  const [newReportType, setNewReportType] = useState<'chat' | 'content'>('chat');
  const [newReason, setNewReason] = useState('Harrassment');
  const [newStatement, setNewStatement] = useState('User sent offensive language in direct chat conversation.');
  const [newUrl, setNewUrl] = useState('www.link123');
  const [newSeverity, setNewSeverity] = useState<'low' | 'medium' | 'high'>('high');
  const [isSubmittingReport, setIsSubmittingReport] = useState(false);

  // Show right-side floating toast
  function showToast(title: string, message: string, type: 'success' | 'error' = 'success') {
    setToast({ title, message, type });
    setTimeout(() => setToast(null), 3800);
  }

  // Fetch reports from MySQL endpoint
  const fetchReports = useCallback(async (page = currentPage, currentFilter = filter, search = searchQuery, size = pageSize) => {
    setIsLoading(true);
    try {
      const params = new URLSearchParams({
        page: String(page),
        limit: String(size),
        filter: currentFilter,
        search
      });
      const res = await fetch(`/api/admin/reports?${params.toString()}`);
      const data = await res.json();
      if (res.ok) {
        setReports(data.reports || []);
        if (data.stats) {
          setStats(data.stats);
        }
        if (data.pagination) {
          setTotalCount(data.pagination.totalCount);
          setTotalPages(data.pagination.totalPages);
          setCurrentPage(data.pagination.currentPage);
        }
      }
    } catch (err) {
      console.error('Failed to load reports:', err);
    } finally {
      setIsLoading(false);
    }
  }, [currentPage, filter, searchQuery, pageSize]);

  useEffect(() => {
    fetchReports(1, filter, searchQuery, pageSize);
  }, [filter, searchQuery, pageSize]);

  // Moderation Action (Suspend, Escalate, Dismiss, Resolve)
  async function handleAction(id: number, action: 'suspend' | 'escalate' | 'dismiss' | 'resolve', userName?: string) {
    setActionLoadingId(id);
    try {
      const res = await fetch('/api/admin/reports', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, action })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Action failed');

      if (action === 'suspend') {
        showToast('User Suspended', `Account "${userName || 'Reported user'}" has been suspended in MySQL.`, 'error');
      } else if (action === 'escalate') {
        showToast('Report Escalated', 'Report was sent for high-priority legal review.');
      } else if (action === 'dismiss') {
        showToast('Report Dismissed', 'Report closed without penalties.');
      } else {
        showToast('Report Resolved', 'Case marked as resolved.');
      }

      if (selectedReport && selectedReport.id === id) {
        setSelectedReport(prev => prev ? { ...prev, status: data.status } : null);
      }

      // Refresh list and stats
      fetchReports(currentPage, filter, searchQuery, pageSize);
    } catch (err: any) {
      showToast('Action Failed', err.message || 'Error executing action', 'error');
    } finally {
      setActionLoadingId(null);
    }
  }

  // Submit a new report (from Chat or Content)
  async function handleSubmitNewReport(e: React.FormEvent) {
    e.preventDefault();
    setIsSubmittingReport(true);
    try {
      const res = await fetch('/api/admin/reports', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          reporter_name: newReporterName,
          reported_user_name: newReportedUser,
          report_type: newReportType,
          reason: newReason,
          statement: newStatement,
          url: newUrl,
          severity: newSeverity,
          status: 'pending'
        })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to submit report');

      showToast('Report Filed in MySQL', `Report ${data.report_code || ''} recorded successfully.`);
      setIsSimulateModalOpen(false);
      fetchReports(1, filter, searchQuery, pageSize);
    } catch (err: any) {
      showToast('Submission Error', err.message || 'Could not submit report', 'error');
    } finally {
      setIsSubmittingReport(false);
    }
  }

  return (
    <div className="space-y-6">
      
      {/* 1. TOP 4 KPI CARDS (Matching exact reference design: 15 Reports, 7 Pending, 10 High Risk, 2 Escalated) */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        
        {/* Card 1: Total Reports */}
        <div className="bg-white dark:bg-[#242526] rounded-2xl p-5 sm:p-6 border border-slate-200/80 dark:border-[#393a3b] shadow-xs flex flex-col justify-center transition-all hover:shadow-sm">
          <div className="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-[#e4e6eb] tracking-tight leading-none">
            {stats.totalReports}
          </div>
          <div className="text-xs sm:text-sm font-bold text-slate-600 dark:text-[#b0b3b8] mt-2 sm:mt-2.5">
            Reports
          </div>
        </div>

        {/* Card 2: Pending (Blue) */}
        <div className="bg-white dark:bg-[#242526] rounded-2xl p-5 sm:p-6 border border-slate-200/80 dark:border-[#393a3b] shadow-xs flex flex-col justify-center transition-all hover:shadow-sm">
          <div className="text-3xl sm:text-4xl font-extrabold text-[#1877f2] dark:text-[#2d88ff] tracking-tight leading-none">
            {stats.pending}
          </div>
          <div className="text-xs sm:text-sm font-bold text-slate-600 dark:text-[#b0b3b8] mt-2 sm:mt-2.5">
            Pending
          </div>
        </div>

        {/* Card 3: High Risk (Coral Red) */}
        <div className="bg-white dark:bg-[#242526] rounded-2xl p-5 sm:p-6 border border-slate-200/80 dark:border-[#393a3b] shadow-xs flex flex-col justify-center transition-all hover:shadow-sm">
          <div className="text-3xl sm:text-4xl font-extrabold text-[#eb5b5b] dark:text-[#f87171] tracking-tight leading-none">
            {stats.highRisk}
          </div>
          <div className="text-xs sm:text-sm font-bold text-slate-600 dark:text-[#b0b3b8] mt-2 sm:mt-2.5">
            High Risk
          </div>
        </div>

        {/* Card 4: Escalated (Purple) */}
        <div className="bg-white dark:bg-[#242526] rounded-2xl p-5 sm:p-6 border border-slate-200/80 dark:border-[#393a3b] shadow-xs flex flex-col justify-center transition-all hover:shadow-sm">
          <div className="text-3xl sm:text-4xl font-extrabold text-[#8b5cf6] dark:text-[#a78bfa] tracking-tight leading-none">
            {stats.escalated}
          </div>
          <div className="text-xs sm:text-sm font-bold text-slate-600 dark:text-[#b0b3b8] mt-2 sm:mt-2.5">
            Escalated
          </div>
        </div>

      </div>

      {/* 2. SEARCH & FILTER TOOLBAR (Exact matching blue border box with inner search pill & clean dropdown) */}
      <div className="bg-white dark:bg-[#242526] rounded-2xl p-3 sm:p-3.5 border-2 border-[#1877f2] dark:border-[#0091ff] shadow-xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 transition-all">
        
        {/* Left: Inner Search Input Pill with gray background */}
        <div className="relative flex-1 flex items-center bg-[#f0f2f5] dark:bg-[#3a3b3c] rounded-xl px-3.5 py-2 transition-colors">
          <Search className="h-4 w-4 text-slate-400 dark:text-[#b0b3b8] shrink-0 mr-2.5" />
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Search reporter , reported, user, reason.."
            className="w-full text-xs sm:text-sm bg-transparent outline-none text-slate-900 dark:text-[#e4e6eb] placeholder:text-slate-500 dark:placeholder:text-[#8a8d91]"
          />
          {searchQuery && (
            <button 
              type="button" 
              onClick={() => setSearchQuery('')}
              className="text-slate-400 hover:text-slate-600 dark:hover:text-white p-0.5"
            >
              <X className="h-3.5 w-3.5" />
            </button>
          )}
        </div>

        {/* Right Controls: Filter Dropdown & Action to file new report */}
        <div className="flex items-center gap-3 shrink-0 justify-between sm:justify-end">
          {/* Dropdown with Chevron Down matching mockup */}
          <div className="relative flex items-center">
            <select
              value={filter}
              onChange={(e) => setFilter(e.target.value)}
              className="appearance-none bg-transparent text-xs sm:text-sm font-semibold text-slate-800 dark:text-[#e4e6eb] outline-none cursor-pointer pr-6 pl-2 py-1"
            >
              <option value="all" className="dark:bg-[#242526]">All</option>
              <option value="pending" className="dark:bg-[#242526]">Pending</option>
              <option value="high_risk" className="dark:bg-[#242526]">High Risk</option>
              <option value="escalated" className="dark:bg-[#242526]">Escalated</option>
              <option value="chat" className="dark:bg-[#242526]">Chat Reports</option>
              <option value="content" className="dark:bg-[#242526]">Content Reports</option>
              <option value="suspended" className="dark:bg-[#242526]">Suspended</option>
              <option value="resolved" className="dark:bg-[#242526]">Resolved</option>
            </select>
            <ChevronDown className="absolute right-0.5 h-4 w-4 pointer-events-none text-slate-600 dark:text-[#b0b3b8]" />
          </div>

          {/* New Report Action Button (Supports testing dynamic ingestion from chat & content) */}
          <button
            type="button"
            onClick={() => setIsSimulateModalOpen(true)}
            className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-[#237227] hover:bg-[#1b5e20] text-white text-xs font-bold transition-all shadow-2xs cursor-pointer ml-1"
            title="File new report from chat or content"
          >
            <Plus className="h-3.5 w-3.5" />
            <span>File Report</span>
          </button>
        </div>
      </div>

      {/* 3. MODERATION REPORTS TABLE (Matching exact columns, clean spacing & Suspend button) */}
      <div className="bg-white dark:bg-[#242526] rounded-2xl border border-slate-200/80 dark:border-[#393a3b] shadow-xs overflow-hidden">
        
        <div className="overflow-x-auto">
          <table className="w-full text-left text-xs sm:text-sm text-slate-700 dark:text-slate-300 border-collapse">
            <thead className="border-b border-slate-200 dark:border-[#393a3b] text-slate-600 dark:text-[#b0b3b8] font-bold uppercase text-[11px] tracking-wider bg-slate-50/60 dark:bg-[#1f2021]">
              <tr>
                <th className="py-4 px-6">ID</th>
                <th className="py-4 px-6">REPORTED BY</th>
                <th className="py-4 px-6">REPORTED USER</th>
                <th className="py-4 px-6">REASON</th>
                <th className="py-4 px-6">STATEMENT</th>
                <th className="py-4 px-6">DATE REPORTED</th>
                <th className="py-4 px-6">URL</th>
                <th className="py-4 px-6 text-right">ACTIONS</th>
              </tr>
            </thead>

            <tbody className="divide-y divide-slate-100 dark:divide-[#393a3b]">
              {isLoading ? (
                <tr>
                  <td colSpan={8} className="py-16 text-center text-sm text-slate-400 dark:text-[#8a8d91]">
                    <div className="flex items-center justify-center gap-2">
                      <RefreshCw className="h-4 w-4 animate-spin text-[#237227]" />
                      <span>Loading moderation records from MySQL...</span>
                    </div>
                  </td>
                </tr>
              ) : reports.length === 0 ? (
                <tr>
                  <td colSpan={8} className="py-16 text-center text-sm text-slate-400 dark:text-[#8a8d91]">
                    No reports found matching your criteria.
                  </td>
                </tr>
              ) : (
                reports.map((r) => {
                  const isSuspended = r.status === 'suspended';
                  const isPendingAction = actionLoadingId === r.id;

                  return (
                    <tr 
                      key={r.id} 
                      className="hover:bg-slate-50/80 dark:hover:bg-[#2f3031] transition-colors"
                    >
                      {/* ID: e.g. RPT- 1 */}
                      <td className="py-4.5 px-6 font-semibold text-slate-900 dark:text-[#e4e6eb] whitespace-nowrap">
                        {r.report_code}
                      </td>

                      {/* REPORTED BY */}
                      <td className="py-4.5 px-6 font-medium text-slate-900 dark:text-[#e4e6eb] whitespace-nowrap">
                        <div className="flex items-center gap-2">
                          <span>{r.reporter_name}</span>
                          {r.report_type === 'chat' ? (
                            <span className="p-0.5 text-blue-500" title="Reported in Direct Chat">
                              <MessageSquare className="h-3 w-3 inline" />
                            </span>
                          ) : (
                            <span className="p-0.5 text-emerald-500" title="Reported on Post/Listing Content">
                              <FileText className="h-3 w-3 inline" />
                            </span>
                          )}
                        </div>
                      </td>

                      {/* REPORTED USER */}
                      <td className="py-4.5 px-6 font-medium text-slate-900 dark:text-[#e4e6eb] whitespace-nowrap">
                        {r.reported_user_name}
                      </td>

                      {/* REASON */}
                      <td className="py-4.5 px-6 font-medium text-slate-800 dark:text-slate-300 whitespace-nowrap">
                        {r.reason}
                      </td>

                      {/* STATEMENT (Comfortably truncated, click to view full statement) */}
                      <td 
                        onClick={() => setSelectedReport(r)}
                        className="py-4.5 px-6 text-slate-600 dark:text-[#b0b3b8] max-w-[200px] sm:max-w-xs truncate cursor-pointer hover:text-[#237227] dark:hover:text-emerald-400 transition-colors"
                        title="Click to view full statement and options"
                      >
                        {r.statement}
                      </td>

                      {/* DATE REPORTED */}
                      <td className="py-4.5 px-6 text-slate-600 dark:text-[#b0b3b8] whitespace-nowrap font-medium">
                        {r.date_reported}
                      </td>

                      {/* URL */}
                      <td className="py-4.5 px-6 whitespace-nowrap text-xs font-medium">
                        <a
                          href={r.url.startsWith('http') ? r.url : `https://${r.url}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="text-slate-700 dark:text-slate-300 hover:text-blue-600 hover:underline flex items-center gap-1"
                        >
                          <span>{r.url}</span>
                          <ExternalLink className="h-3 w-3 opacity-60" />
                        </a>
                      </td>

                      {/* ACTIONS: Suspend button matching screenshot */}
                      <td className="py-4.5 px-6 text-right whitespace-nowrap">
                        {isSuspended ? (
                          <div className="inline-flex items-center gap-2">
                            <span className="inline-flex items-center gap-1 px-3 py-1 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-[#eb5b5b] dark:text-rose-400 font-bold text-xs border border-rose-200/60 dark:border-rose-900/40">
                              <UserX className="h-3.5 w-3.5" />
                              Suspended
                            </span>
                            <button
                              type="button"
                              onClick={() => handleAction(r.id, 'resolve', r.reported_user_name)}
                              className="p-1 text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors cursor-pointer"
                              title="Reinstate / Resolve user"
                            >
                              <RotateCcw className="h-3.5 w-3.5" />
                            </button>
                          </div>
                        ) : (
                          <button
                            type="button"
                            onClick={() => handleAction(r.id, 'suspend', r.reported_user_name)}
                            disabled={isPendingAction}
                            className="px-5 py-1.5 rounded-xl bg-[#eb5b5b] hover:bg-[#de4747] text-white font-bold text-xs shadow-xs transition-all active:scale-95 cursor-pointer disabled:opacity-50"
                            title="Suspend reported user"
                          >
                            {isPendingAction ? 'Suspending...' : 'Suspend'}
                          </button>
                        )}
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>

        {/* 4. DYNAMIC PAGINATION CONTROLS (Unified layout matching reference image: < 1 2 3 4 5 >) */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-6 py-4 border-t border-slate-100 dark:border-[#393a3b] text-xs text-slate-500 dark:text-[#b0b3b8]">
          
          {/* Left: Showing entries & Page Size selector */}
          <div className="flex items-center gap-3 flex-wrap">
            <div>
              Showing <span className="font-semibold text-slate-800 dark:text-[#e4e6eb]">{totalCount === 0 ? 0 : (currentPage - 1) * pageSize + 1}</span> to{' '}
              <span className="font-semibold text-slate-800 dark:text-[#e4e6eb]">{Math.min(currentPage * pageSize, totalCount)}</span> of{' '}
              <span className="font-semibold text-slate-800 dark:text-[#e4e6eb]">{totalCount}</span> reports
            </div>

            {/* Items Per Page Selector */}
            <div className="flex items-center gap-1 pl-2 border-l border-slate-200 dark:border-[#393a3b]">
              <span className="text-[11px]">Per page:</span>
              {[6, 12, 24].map((size) => (
                <button
                  key={size}
                  type="button"
                  onClick={() => {
                    setPageSize(size);
                    setCurrentPage(1);
                  }}
                  className={`px-2 py-0.5 rounded-md text-[11px] font-bold transition-all cursor-pointer ${
                    pageSize === size
                      ? 'bg-[#237227] text-white shadow-2xs'
                      : 'border border-slate-200 dark:border-[#393a3b] bg-slate-50 dark:bg-[#18191a] text-slate-600 dark:text-[#b0b3b8] hover:border-slate-300'
                  }`}
                >
                  {size}
                </button>
              ))}
            </div>
          </div>

          {/* Right: < 1 2 3 4 5 > exact pagination buttons with green active pill */}
          <div className="flex items-center gap-1.5 self-end sm:self-auto">
            <button
              type="button"
              onClick={() => setCurrentPage(prev => Math.max(1, prev - 1))}
              disabled={currentPage <= 1}
              className="p-1.5 rounded-lg border border-slate-200 dark:border-[#393a3b] hover:bg-slate-50 dark:hover:bg-[#3a3b3c] disabled:opacity-30 disabled:pointer-events-none transition-colors cursor-pointer text-slate-600 dark:text-[#b0b3b8]"
              title="Previous Page"
            >
              <ChevronLeft className="h-3.5 w-3.5" />
            </button>

            {Array.from({ length: totalPages }, (_, i) => i + 1)
              .filter(page => page === 1 || page === totalPages || Math.abs(page - currentPage) <= 2)
              .map((page, idx, arr) => {
                const prevPage = arr[idx - 1];
                const showEllipsis = prevPage && page - prevPage > 1;

                return (
                  <React.Fragment key={page}>
                    {showEllipsis && <span className="px-1 text-slate-400">...</span>}
                    <button
                      key={page}
                      type="button"
                      onClick={() => setCurrentPage(page)}
                      className={`min-w-[28px] h-7 px-2 rounded-lg text-xs font-bold transition-all cursor-pointer ${
                        currentPage === page
                          ? 'bg-[#48a868] text-white shadow-xs'
                          : 'border border-slate-200 dark:border-[#393a3b] hover:bg-slate-50 dark:hover:bg-[#3a3b3c] text-slate-700 dark:text-[#e4e6eb]'
                      }`}
                    >
                      {page}
                    </button>
                  </React.Fragment>
                );
              })}

            <button
              type="button"
              onClick={() => setCurrentPage(prev => Math.min(totalPages, prev + 1))}
              disabled={currentPage >= totalPages}
              className="p-1.5 rounded-lg border border-slate-200 dark:border-[#393a3b] hover:bg-slate-50 dark:hover:bg-[#3a3b3c] disabled:opacity-30 disabled:pointer-events-none transition-colors cursor-pointer text-slate-600 dark:text-[#b0b3b8]"
              title="Next Page"
            >
              <ChevronRight className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>

      </div>

      {/* MODAL 1: REPORT DETAILS & EXTENDED ACTIONS */}
      {selectedReport && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in">
          <div className="bg-white dark:bg-[#242526] border border-slate-200 dark:border-[#393a3b] rounded-2xl max-w-lg w-full p-6 space-y-5 shadow-2xl">
            
            <div className="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-[#393a3b]">
              <div className="flex items-center gap-2">
                <span className="font-mono font-bold text-base text-slate-900 dark:text-[#e4e6eb]">
                  {selectedReport.report_code}
                </span>
                <span className={`text-[11px] font-bold uppercase px-2.5 py-0.5 rounded-full ${
                  selectedReport.report_type === 'chat' 
                    ? 'bg-blue-50 text-blue-600 dark:bg-blue-950/60 dark:text-blue-400' 
                    : 'bg-emerald-50 text-emerald-600 dark:bg-emerald-950/60 dark:text-emerald-400'
                }`}>
                  {selectedReport.report_type} Report
                </span>
              </div>
              <button
                type="button"
                onClick={() => setSelectedReport(null)}
                className="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-white cursor-pointer"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            <div className="space-y-3.5 text-xs">
              <div className="grid grid-cols-2 gap-3">
                <div className="p-3 rounded-xl bg-slate-50 dark:bg-[#18191a] border border-slate-200/60 dark:border-[#393a3b]">
                  <span className="text-[10px] text-slate-400 uppercase font-bold block">Reported By</span>
                  <span className="font-bold text-slate-800 dark:text-[#e4e6eb] text-sm mt-0.5 block">{selectedReport.reporter_name}</span>
                </div>
                <div className="p-3 rounded-xl bg-slate-50 dark:bg-[#18191a] border border-slate-200/60 dark:border-[#393a3b]">
                  <span className="text-[10px] text-slate-400 uppercase font-bold block">Reported User</span>
                  <span className="font-bold text-slate-800 dark:text-[#e4e6eb] text-sm mt-0.5 block">{selectedReport.reported_user_name}</span>
                </div>
              </div>

              <div>
                <span className="text-[11px] font-bold text-slate-400 block mb-1">Violation Reason</span>
                <div className="p-2.5 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 font-semibold border border-amber-200/60 dark:border-amber-900/60">
                  {selectedReport.reason}
                </div>
              </div>

              <div>
                <span className="text-[11px] font-bold text-slate-400 block mb-1">Detailed Statement</span>
                <div className="p-3 rounded-xl bg-slate-50 dark:bg-[#18191a] text-slate-700 dark:text-slate-200 border border-slate-200/80 dark:border-[#393a3b] leading-relaxed">
                  {selectedReport.statement}
                </div>
              </div>

              <div className="flex items-center justify-between text-slate-500 pt-1">
                <span>Date: {selectedReport.date_reported}</span>
                <span className="font-mono">{selectedReport.url}</span>
              </div>
            </div>

            {/* Actions in Modal */}
            <div className="flex items-center justify-end gap-2 pt-3 border-t border-slate-100 dark:border-[#393a3b]">
              <button
                type="button"
                onClick={() => handleAction(selectedReport.id, 'dismiss', selectedReport.reported_user_name)}
                className="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-[#393a3b] text-slate-600 dark:text-[#e4e6eb] hover:bg-slate-100 text-xs font-semibold cursor-pointer"
              >
                Dismiss
              </button>
              <button
                type="button"
                onClick={() => handleAction(selectedReport.id, 'escalate', selectedReport.reported_user_name)}
                className="px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold shadow-xs cursor-pointer"
              >
                Escalate
              </button>
              <button
                type="button"
                onClick={() => handleAction(selectedReport.id, 'resolve', selectedReport.reported_user_name)}
                className="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs cursor-pointer"
              >
                Resolve
              </button>
              <button
                type="button"
                onClick={() => handleAction(selectedReport.id, 'suspend', selectedReport.reported_user_name)}
                className="px-4 py-1.5 rounded-xl bg-[#eb5b5b] hover:bg-[#de4747] text-white text-xs font-bold shadow-xs cursor-pointer"
              >
                Suspend User
              </button>
            </div>

          </div>
        </div>
      )}

      {/* MODAL 2: FILE REPORT FROM CHAT / CONTENT (Tests dynamic MySQL ingestion) */}
      {isSimulateModalOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in">
          <div className="bg-white dark:bg-[#242526] border border-slate-200 dark:border-[#393a3b] rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
            <div className="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-[#393a3b]">
              <div className="flex items-center gap-2">
                <Shield className="h-5 w-5 text-[#237227]" />
                <h3 className="font-bold text-slate-900 dark:text-[#e4e6eb] text-sm">File Report (Chat / Content)</h3>
              </div>
              <button
                type="button"
                onClick={() => setIsSimulateModalOpen(false)}
                className="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-white cursor-pointer"
              >
                <X className="h-4 w-4" />
              </button>
            </div>

            <form onSubmit={handleSubmitNewReport} className="space-y-3.5 text-xs">
              <div>
                <label className="block font-bold text-slate-700 dark:text-[#e4e6eb] mb-1">Report Type</label>
                <div className="grid grid-cols-2 gap-2">
                  <button
                    type="button"
                    onClick={() => setNewReportType('chat')}
                    className={`py-2 px-3 rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer ${
                      newReportType === 'chat'
                        ? 'border-blue-500 bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-400'
                        : 'border-slate-200 dark:border-[#393a3b] text-slate-600 dark:text-[#b0b3b8]'
                    }`}
                  >
                    <MessageSquare className="h-3.5 w-3.5" /> Direct Chat
                  </button>
                  <button
                    type="button"
                    onClick={() => setNewReportType('content')}
                    className={`py-2 px-3 rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer ${
                      newReportType === 'content'
                        ? 'border-emerald-500 bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-400'
                        : 'border-slate-200 dark:border-[#393a3b] text-slate-600 dark:text-[#b0b3b8]'
                    }`}
                  >
                    <FileText className="h-3.5 w-3.5" /> Post / Content
                  </button>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-bold text-slate-700 dark:text-[#e4e6eb] mb-1">Reporter</label>
                  <input
                    type="text"
                    required
                    value={newReporterName}
                    onChange={(e) => setNewReporterName(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-[#393a3b] bg-slate-50 dark:bg-[#18191a] text-slate-900 dark:text-[#e4e6eb] outline-none"
                  />
                </div>
                <div>
                  <label className="block font-bold text-slate-700 dark:text-[#e4e6eb] mb-1">Reported User</label>
                  <input
                    type="text"
                    required
                    value={newReportedUser}
                    onChange={(e) => setNewReportedUser(e.target.value)}
                    className="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-[#393a3b] bg-slate-50 dark:bg-[#18191a] text-slate-900 dark:text-[#e4e6eb] outline-none"
                  />
                </div>
              </div>

              <div>
                <label className="block font-bold text-slate-700 dark:text-[#e4e6eb] mb-1">Violation Reason</label>
                <select
                  value={newReason}
                  onChange={(e) => setNewReason(e.target.value)}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-[#393a3b] bg-slate-50 dark:bg-[#18191a] text-slate-900 dark:text-[#e4e6eb] outline-none"
                >
                  <option value="Harrassment">Harrassment</option>
                  <option value="Scam / Fraud">Scam / Fraud</option>
                  <option value="Counterfeit Goods">Counterfeit Goods</option>
                  <option value="Phishing Links">Phishing Links</option>
                  <option value="Fake Identity">Fake Identity</option>
                  <option value="Misleading Offer">Misleading Offer</option>
                  <option value="Spam & Bots">Spam & Bots</option>
                </select>
              </div>

              <div>
                <label className="block font-bold text-slate-700 dark:text-[#e4e6eb] mb-1">Statement</label>
                <textarea
                  required
                  rows={3}
                  value={newStatement}
                  onChange={(e) => setNewStatement(e.target.value)}
                  className="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-[#393a3b] bg-slate-50 dark:bg-[#18191a] text-slate-900 dark:text-[#e4e6eb] outline-none"
                  placeholder="Describe the incident or abusive message..."
                />
              </div>

              <div className="flex justify-end gap-2 pt-2 border-t border-slate-100 dark:border-[#393a3b]">
                <button
                  type="button"
                  onClick={() => setIsSimulateModalOpen(false)}
                  className="px-3 py-1.5 rounded-xl border border-slate-200 dark:border-[#393a3b] text-slate-600 dark:text-[#e4e6eb] font-semibold text-xs cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={isSubmittingReport}
                  className="px-4 py-1.5 rounded-xl bg-[#237227] hover:bg-[#1b5e20] text-white font-bold text-xs shadow-xs transition-all disabled:opacity-50 cursor-pointer"
                >
                  {isSubmittingReport ? 'Submitting...' : 'Submit Report'}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Floating Animated Right Toast */}
      {typeof document !== 'undefined' && toast && createPortal(
        <div className="fixed top-6 right-6 z-[100000] max-w-sm w-full animate-slide-in-right pointer-events-auto">
          <div className={`bg-white dark:bg-[#242526] border rounded-2xl p-4 flex items-start gap-3.5 shadow-2xl backdrop-blur-md ${
            toast.type === 'error'
              ? 'border-rose-500/30 dark:border-rose-500/40'
              : 'border-emerald-500/30 dark:border-emerald-500/40'
          }`}>
            <div className={`h-9 w-9 rounded-xl flex items-center justify-center shrink-0 ${
              toast.type === 'error'
                ? 'bg-rose-50 dark:bg-rose-950/60 text-[#eb5b5b] dark:text-rose-400'
                : 'bg-emerald-50 dark:bg-emerald-950/60 text-[#237227] dark:text-emerald-400'
            }`}>
              {toast.type === 'error' ? <AlertCircle className="h-5 w-5" /> : <CheckCircle className="h-5 w-5" />}
            </div>
            <div className="flex-1 min-w-0 pt-0.5">
              <div className="text-xs font-bold text-slate-900 dark:text-[#e4e6eb]">
                {toast.title}
              </div>
              <div className="text-[11px] text-slate-500 dark:text-[#b0b3b8] mt-0.5 leading-snug">
                {toast.message}
              </div>
            </div>
            <button
              onClick={() => setToast(null)}
              className="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 cursor-pointer"
            >
              <X className="h-3.5 w-3.5" />
            </button>
          </div>
        </div>,
        document.body
      )}

    </div>
  );
}
